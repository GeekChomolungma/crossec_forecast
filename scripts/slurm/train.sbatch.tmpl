#!/usr/bin/env bash
#SBATCH -p gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-gpu=16
#SBATCH --mem-per-gpu=64G
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH -t 12:00:00
#SBATCH -J @@JOB_NAME@@
#SBATCH -D @@PROJECT_DIR@@
#SBATCH -o /projects/prjs1859/users/%u/slurm/logs/%x_%j.out
#SBATCH -e /projects/prjs1859/users/%u/slurm/logs/%x_%j.err
@@EXTRA_SBATCH@@
# =====================================================================================
# TEMPLATE for scripts/sweep.py --launcher slurm. For each sweep job it is copied to
# runs/_sweeps/<...>/sbatch/<job>.sbatch with six markers substituted (double-at tokens):
# JOB_NAME, PROJECT_DIR (cluster clone path), ENTRY_SCRIPT (scripts/train.py or
# scripts/benchmark.py), CONFIG_PATH (this job's resolved config), EXTRA_SBATCH,
# ENV_SCRIPT (interpreter-activation script; from spec `slurm.env_script`, default
# "${ROOT_BASE}/load_exp_env.sh" — set it per env-specific sweep spec).
# Everything else — including the bash ${...} below — is kept verbatim.
#
# Edit THIS file, not the rendered copies. Adjust the -p / -t / --mem-per-gpu / -o / -e
# header for your account; if you launch from the /gpfs mount fix the /projects prefix.
# =====================================================================================

# --- 固化 HF 缓存路径与离线模式 ---
export HF_HOME="/projects/prjs1859/users/xzhang4/.cache/huggingface"
export HF_HUB_OFFLINE=1

set -euo pipefail

if [[ -z "${ROOT_BASE:-}" ]]; then
  if [[ -d "/projects/prjs1859" ]]; then
    ROOT_BASE="/projects/prjs1859"
  elif [[ -d "/gpfs/work5/0/prjs1859" ]]; then
    ROOT_BASE="/gpfs/work5/0/prjs1859"
  else
    echo "[cf-sweep] cannot resolve ROOT_BASE; set ROOT_BASE explicitly" >&2
    exit 1
  fi
fi
PROJECT_DIR="${PROJECT_DIR:-@@PROJECT_DIR@@}"
LOG_DIR="${LOG_DIR:-${ROOT_BASE}/users/${USER}/slurm/logs}"
mkdir -p "${LOG_DIR}"

source "@@ENV_SCRIPT@@"

which python
python -c "import torch; print('torch ok', torch.__version__, '| cuda', torch.cuda.is_available())"

# ==============================================================================
# HF Cache Manual Management Guide (Pre-warm before launching jobs)
# ==============================================================================
#
# 1. 登录节点预下载 (Download):
#    # 下载单个模型
#    huggingface-cli download AutonLab/MOMENT-1-small
#
#    # 批量下载多个模型
#    for repo in "AutonLab/MOMENT-1-small" "AutonLab/MOMENT-1-base" "amazon/chronos-bolt-small"; do
#      huggingface-cli download "${repo}"
#    done
#
# 2. 缓存查看与删除 (Inspect & Delete):
#    # 查看所有已缓存的 HF 模型与占用空间
#    huggingface-cli scan-cache
#
#    # 交互式安全删除指定模型缓存 (推荐)
#    huggingface-cli delete-cache
#
#    # 硬删除指定模型缓存 (根据 repo_id 构造路径):
#    # rm -rf "${HF_HOME:-$HOME/.cache/huggingface}/hub/models--AutonLab--MOMENT-1-small"
#
#    # 清空所有 HF 缓存 (慎用):
#    # rm -rf "${HF_HOME:-$HOME/.cache/huggingface}/hub"/*
# ==============================================================================


# --- business ----------------------------------------------------------------------
cd "${PROJECT_DIR}"
export PYTHONUNBUFFERED=1
# Default to online logging; compute nodes without internet can override with
#   WANDB_MODE=offline sbatch ...   (then `wandb sync runs/**/wandb/offline-run-*` later)
export WANDB_MODE="${WANDB_MODE:-online}"

echo "[cf-sweep] python @@ENTRY_SCRIPT@@ -c @@CONFIG_PATH@@"
python @@ENTRY_SCRIPT@@ -c @@CONFIG_PATH@@
